<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:elevation="6dp"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/text_numero_questao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:textColor="@color/color_text_secondary" />

            <TextView
                android:id="@+id/text_tempo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_primary"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/color_on_primary_container" />

        </LinearLayout>

        <TextView
            android:id="@+id/text_pergunta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/color_on_surface"
            android:layout_marginBottom="24dp" />

        <RadioGroup
            android:id="@+id/radio_group_alternativas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_alt_a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_alternativa_radio"
                android:buttonTint="@color/color_primary"
                android:textColor="@color/color_on_surface"
                android:padding="14dp"
                android:layout_marginBottom="10dp" />

            <RadioButton
                android:id="@+id/radio_alt_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_alternativa_radio"
                android:buttonTint="@color/color_primary"
                android:textColor="@color/color_on_surface"
                android:padding="14dp"
                android:layout_marginBottom="10dp" />

            <RadioButton
                android:id="@+id/radio_alt_c"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_alternativa_radio"
                android:buttonTint="@color/color_primary"
                android:textColor="@color/color_on_surface"
                android:padding="14dp"
                android:layout_marginBottom="10dp" />

            <RadioButton
                android:id="@+id/radio_alt_d"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_alternativa_radio"
                android:buttonTint="@color/color_primary"
                android:textColor="@color/color_on_surface"
                android:padding="14dp"
                android:layout_marginBottom="10dp" />

            <RadioButton
                android:id="@+id/radio_alt_e"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_alternativa_radio"
                android:buttonTint="@color/color_primary"
                android:textColor="@color/color_on_surface"
                android:padding="14dp" />

        </RadioGroup>

        <Button
            android:id="@+id/btn_confirmar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/botao_confirmar"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/text_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/color_on_primary_container"
            android:gravity="center"
            android:padding="14dp"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
