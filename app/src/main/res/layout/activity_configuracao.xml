<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="16dp"
        android:background="@drawable/bg_card"
        android:elevation="6dp"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_configuracao"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/color_primary"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_materias"
            android:textStyle="bold"
            android:textColor="@color/color_on_surface"
            android:layout_marginBottom="8dp" />

        <CheckBox
            android:id="@+id/check_portugues"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/color_primary"
            android:text="@string/materia_portugues"
            android:checked="true" />

        <CheckBox
            android:id="@+id/check_matematica"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/color_primary"
            android:text="@string/materia_matematica"
            android:checked="true"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_quantidade"
            android:textStyle="bold"
            android:textColor="@color/color_on_surface"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/color_on_surface"
                android:text="@string/materia_portugues" />

            <Button
                android:id="@+id/btn_menos_portugues"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cornerRadius="12dp"
                android:text="@string/simbolo_menos" />

            <TextView
                android:id="@+id/text_quantidade_portugues"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="@color/color_on_surface"
                android:text="5" />

            <Button
                android:id="@+id/btn_mais_portugues"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cornerRadius="12dp"
                android:text="@string/simbolo_mais" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/color_on_surface"
                android:text="@string/materia_matematica" />

            <Button
                android:id="@+id/btn_menos_matematica"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cornerRadius="12dp"
                android:text="@string/simbolo_menos" />

            <TextView
                android:id="@+id/text_quantidade_matematica"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="@color/color_on_surface"
                android:text="5" />

            <Button
                android:id="@+id/btn_mais_matematica"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cornerRadius="12dp"
                android:text="@string/simbolo_mais" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_tempo"
            android:textStyle="bold"
            android:textColor="@color/color_on_surface"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="32dp">

            <Button
                android:id="@+id/btn_menos_tempo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cornerRadius="12dp"
                android:text="@string/simbolo_menos" />

            <TextView
                android:id="@+id/text_tempo"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="@color/color_on_surface"
                android:text="30 segundos" />

            <Button
                android:id="@+id/btn_mais_tempo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cornerRadius="12dp"
                android:text="@string/simbolo_mais" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_jogar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/botao_jogar" />

    </LinearLayout>

</ScrollView>
